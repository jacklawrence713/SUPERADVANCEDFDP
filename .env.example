# Fantasy Draft Pros — Environment Variables
# Copy this file to .env and fill in all values before deploying

# ── Supabase ────────────────────────────────────────────────────────────────
VITE_SUPABASE_URL=https://wizdxspglxpvvogiivsv.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here
VITE_SUPABASE_SERVICE_KEY=your_supabase_service_role_key_here

# ── Stripe ──────────────────────────────────────────────────────────────────
# Get from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Price IDs — create these in Stripe Dashboard > Products
STRIPE_PRICE_PRO_MONTHLY=price_...
STRIPE_PRICE_PRO_YEARLY=price_...
STRIPE_PRICE_ELITE_MONTHLY=price_...

# ── Resend ──────────────────────────────────────────────────────────────────
# Get from https://resend.com/api-keys
# Also verify your domain (fantasydraftpros.com) in Resend Dashboard
RESEND_API_KEY=re_...

# ── Anthropic (Claude) ──────────────────────────────────────────────────────
# Get from https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# ── App ─────────────────────────────────────────────────────────────────────
SITE_URL=https://fantasydraftpros.com
